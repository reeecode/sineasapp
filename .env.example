# ==========================================
# SINEAS HSS STREAM - ENVIRONMENT CONFIG
# ==========================================

# Supabase Project URL & Anon Public API Key
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NUXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# TipTip Webhook Verification Token (Opsional untuk verifikasi header TipTip)
TIPTIP_VERIFICATION_TOKEN=your_tiptip_webhook_token_here

# TipTip Creator / Tip Page URL (Link profil TipTip komunitas untuk pembayaran langsung)
# Contoh: https://tiptip.co/p/sineashss atau https://tiptip.id/...
NUXT_PUBLIC_TIPTIP_URL=https://tiptip.co
